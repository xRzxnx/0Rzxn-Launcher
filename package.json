{
  "name": "0rzxn-launcher",
  "productName": "0Rzxn_ Launcher",
  "version": "0.3.3",
  "description": "A modern launcher for Minecraft: Java Edition (not an official Minecraft product)",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "0Rzxn_",
  "scripts": {
    "start": "electron .",
    "apercu": "electron scripts/apercu.js",
    "dist": "electron-builder --win --publish never",
    "icon": "electron scripts/make-icon.js",
    "publier": "node scripts/publier.js",
    "check:i18n": "node scripts/check-i18n.js"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.0rzxn.launcher",
    "productName": "0Rzxn_ Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "0Rzxn_ Launcher",
      "artifactName": "0Rzxn_-Launcher-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "fr_FR",
        "en_US",
        "es_ES"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xRzxnx",
        "repo": "0Rzxn-Launcher",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
