{
  "name": "0rzxn-launcher",
  "productName": "0Rzxn_ Launcher",
  "version": "0.5.0",
  "description": "A modern launcher for Minecraft: Java Edition (not an official Minecraft product)",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "0Rzxn_",
  "scripts": {
    "start": "electron .",
    "apercu": "electron scripts/apercu.js",
    "test": "node --test test/*.test.js",
    "check:types": "tsc --noEmit -p jsconfig.json",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n.js",
    "dist": "electron-builder --win --publish never",
    "icon": "electron scripts/make-icon.js",
    "publier": "node scripts/publier.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@types/node": "24.19.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "preact": "11.0.2",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.0rzxn.launcher",
    "productName": "0Rzxn_ Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "0Rzxn_ Launcher",
      "artifactName": "0Rzxn_-Launcher-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "fr_FR",
        "en_US",
        "es_ES"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xRzxnx",
        "repo": "0Rzxn-Launcher",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
