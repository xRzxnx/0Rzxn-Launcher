{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "0Rzxn_ Launcher",
  "mainBinaryName": "0Rzxn_ Launcher",
  "identifier": "com.0rzxn.launcher",
  "build": {
    "frontendDist": "../interface/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../interface", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../interface" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "principale",
        "title": "0Rzxn_ Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": false,
        "backgroundColor": "#140c22",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://cdn.modrinth.com; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../build/icon.png", "../../build/icon.ico"],
    "publisher": "0Rzxn_",
    "shortDescription": "A modern launcher for Minecraft: Java Edition (not an official Minecraft product)",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English", "Spanish"]
      }
    }
  }
}
